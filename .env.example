# Configurações da Aplicação Flask
FLASK_SECRET_KEY=sua_chave_secreta_aqui_mude_isso
FLASK_DEBUG=True

# Senha de Confirmação para Exclusão de Manifestos (apenas admin)
ADMIN_DELETE_PASSWORD=sua_senha_de_exclusao

# Google Sheets - ID da Planilha
GOOGLE_SPREADSHEET_ID=seu_id_da_planilha_aqui

# Credenciais do Google (arquivo separado)
# Crie um arquivo credentials.json com as credenciais da sua Service Account
# Baixe de: https://console.cloud.google.com/

# Usuário Admin Inicial (usado pelo criar_admin.py)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_FULLNAME=Administrador Geral

# Usuário Operador de Teste (usado pelo criar_admin.py)
OPERADOR_USERNAME=operador
OPERADOR_PASSWORD=1234
OPERADOR_FULLNAME=Operador Padrão
